Bootstrap: docker
From: python:3.12-bullseye

%files
    object_classification_main.py /app/object_classification_main.py
    object_classification_utils.py /app/object_classification_utils.py
    ../proposal/mask_utils.py /app/mask_utils.py
    requirements.txt /app/requirements.txt # Ensure this file exists, even if empty

%environment
    export PATH="/usr/local/bin:/app:$PATH" # Add /app to PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    # Ensure the script is executable
    echo "Setting up environment for object_classification_main.py"
    apt-get update
    echo "Installing libGL and other common X11/graphics dependencies for OpenCV..."
    # Installing a broader set of libraries that OpenCV often needs
    apt-get install -y --no-install-recommends \
        libgl1-mesa-glx \
        libxext6 \
        libxrender1 \
        libfontconfig1 \
        libsm6 \
        libice6 \
        # Optionally, you can add libjpeg-dev, libpng-dev, libtiff-dev if you have issues with image formats
        # and are building opencv from source, though pip version usually handles this.

    echo "Verifying libGL.so.1 existence:"
    find /usr -name "libGL.so.1" || echo "libGL.so.1 not found after install!"
    rm -rf /var/lib/apt/lists/*
    echo "Installing required packages"
    cd /app
    python3 -m pip install --upgrade pip
    pip install --no-cache-dir -r requirements.txt
    echo "Python dependencies installed."
    echo "Making object_classification_main.py executable"
    chmod -R 777 /app/object_classification_main.py
    chmod -R 777 /app/object_classification_utils.py
    chmod -R 777 /app/mask_utils.py
    echo "Setup complete."

%runscript
    echo "object_classification_main.py"
    cd /app
    python3 object_classification_main.py "$@"
%labels
    Maintainer "Brijesh Nanda <brundayogananda.1@osu.edu>"
    Version "1.0"
    Appname "Mask Classifier"
    Description "few-shot mask classification using DINOv3 cosine similarity"