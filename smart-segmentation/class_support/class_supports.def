Bootstrap: docker
From: python:3.12-bullseye

%files
    generate_class_supports_main.py /app/generate_class_supports_main.py
    class_supports_utils.py /app/class_supports_utils.py
    ../proposal/mask_utils.py /app/mask_utils.py
    requirements.txt /app/requirements.txt # Ensure this file exists, even if empty

%environment
    export PATH="/usr/local/bin:/app:$PATH" # Add /app to PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    # Ensure the script is executable
    echo "Setting up environment for generate_class_supports_main.py"
    apt-get update
    echo "Installing libGL and other common X11/graphics dependencies for OpenCV..."
    # Installing a broader set of libraries that OpenCV often needs
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libxext6 \
        libxrender1 \
        libfontconfig1 \
        libsm6 \
        libice6

    echo "Verifying libGL.so.1 existence:"
    find /usr -name "libGL.so.1" || echo "libGL.so.1 not found after install!"
    rm -rf /var/lib/apt/lists/*
    echo "Installing required packages"
    cd /app
    python3 -m pip install --upgrade pip
    pip install --no-cache-dir -r requirements.txt
    echo "Python dependencies installed."
    echo "Making generate_class_supports_main.py executable"
    chmod 755 /app/generate_class_supports_main.py
    chmod 644 /app/class_supports_utils.py
    chmod 644 /app/mask_utils.py
    echo "Setup complete."

%runscript
    echo "generate_class_supports_main.py"
    cd /app
    python3 generate_class_supports_main.py "$@"


%labels
    Maintainer "Brijesh Nanda <brundayogananda.1@osu.edu>"
    Version "1.0"
    Appname "Class Support Generator"
    Description "DINOv3 class-support embeddings from SAM3 GT masks (segmentation)"